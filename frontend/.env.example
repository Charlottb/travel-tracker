# Frontend environment for local development.
# Copy this file to frontend/.env.local.

# Public URL of the Next.js app. Keep this aligned with frontend/package.json
# ("next dev -p 3000").
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Internal URL used by Next API routes to proxy requests to Express.
BACKEND_URL=http://localhost:3003

# Browser-side API base. The default proxies through Next API routes.
NEXT_PUBLIC_API_BASE_URL=/api

# Browser-side backend URL for SSE and socket.io connections.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3003

# Optional verbose fetch logging in development.
NEXT_PUBLIC_DEBUG_API=false
