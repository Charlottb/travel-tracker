# Backend environment for local development.
# Copy this file to backend/.env.

# SQLite database file relative to backend/.
DATABASE_URL="file:./dev.db"

# Local-only JWT secret. Replace this before any real deployment.
JWT_SECRET="dev-secret-change-me"

# Express backend port and canonical backend URL.
PORT=3003
BACKEND_URL="http://localhost:3003"

# Frontend origin allowed by CORS and CSRF origin checks.
FRONTEND_URL="http://localhost:3000"

# Optional: only needed when real transactional e-mails should be sent.
# Leave RESEND_API_KEY empty for local development without e-mail delivery.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@travel-tracker.local"
